# Authorization Service Environment Variables
PORT=8082

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vaultix_auth_db
SPRING_DATASOURCE_USERNAME=auth_user
SPRING_DATASOURCE_PASSWORD=auth_password

# Initial Admin Bootstrapping (initial password must be set via password reset)
VAULTIX_ADMIN_ENABLED=true
VAULTIX_ADMIN_USERNAME=admin
VAULTIX_ADMIN_EMAIL=admin@vaultix.com
VAULTIX_ADMIN_FULL_NAME=Vaultix Administrator

# Security & Master Key (KEK) for AES-256 Private Key Encryption at Rest
VAULTIX_SECURITY_KEK_MASTER_KEY=3xhw5B4DZicmirWLS4h3ZkA4pBFZwyKlG6cvEYvdf7I=

# Account Lockout Policy
VAULTIX_AUTH_LOCKOUT_MAX_FAILED_ATTEMPTS=5
VAULTIX_AUTH_LOCKOUT_DURATION=15m

# Redis Configuration (Cache & Cross-Instance Pub/Sub)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_USERNAME=auth_user
SPRING_DATA_REDIS_PASSWORD=auth_password

# RabbitMQ Configuration (Message Broker)
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=auth_user
SPRING_RABBITMQ_PASSWORD=auth_password
SPRING_RABBITMQ_VIRTUAL_HOST=/

# JWT Token Lifespans & Issuer
VAULTIX_JWT_ISSUER=https://auth.vaultix.com
VAULTIX_JWT_ACCESS_TOKEN_EXPIRATION=5m
VAULTIX_JWT_REFRESH_TOKEN_EXPIRATION=7d

# Automatic Signing Key Rotation Schedule (Daily at 02:00 AM)
VAULTIX_KEY_ROTATION_CRON=0 0 2 * * ?

# Automatic Signing Key Cleanup Schedule (Daily at 02:10 AM - 10 min after rotation)
VAULTIX_KEY_CLEANUP_CRON=0 10 2 * * ?
VAULTIX_KEY_CLEANUP_GRACE_PERIOD=7d
VAULTIX_KEY_CLEANUP_BATCH_SIZE=100

# Automatic Refresh Token (Session) Cleanup Schedule (Daily at 02:20 AM - 10 min after key cleanup)
VAULTIX_REFRESH_TOKEN_CLEANUP_CRON=0 20 2 * * ?
VAULTIX_REFRESH_TOKEN_CLEANUP_GRACE_PERIOD=7d
VAULTIX_REFRESH_TOKEN_CLEANUP_BATCH_SIZE=500

# Automatic Soft-Deleted Roles Cleanup Schedule (Daily at 02:30 AM - 10 min after token cleanup)
VAULTIX_ROLE_CLEANUP_CRON=0 30 2 * * ?
VAULTIX_ROLE_CLEANUP_GRACE_PERIOD=30d
VAULTIX_ROLE_CLEANUP_BATCH_SIZE=100

# Automatic Soft-Deleted Users Cleanup Schedule (Daily at 02:40 AM - 10 min after role cleanup)
VAULTIX_USER_CLEANUP_CRON=0 40 2 * * ?
VAULTIX_USER_CLEANUP_GRACE_PERIOD=90d
VAULTIX_USER_CLEANUP_BATCH_SIZE=100

# One-Time Password (OTP) Policy
VAULTIX_OTP_LENGTH=6
VAULTIX_OTP_DEFAULT_TTL=10m
VAULTIX_OTP_MAX_ATTEMPTS=5

# RabbitMQ Event Routing
VAULTIX_RABBITMQ_AUTH_EXCHANGE=auth.exchange
VAULTIX_RABBITMQ_AUTH_PASSWORD_RESET_ROUTING_KEY=auth.notification.password-reset
VAULTIX_RABBITMQ_AUTH_EMAIL_VERIFICATION_ROUTING_KEY=auth.notification.email-verification
VAULTIX_RABBITMQ_AUTH_WELCOME_ROUTING_KEY=auth.notification.welcome
VAULTIX_RABBITMQ_AUTH_PASSWORD_CHANGED_ROUTING_KEY=auth.notification.password-changed
VAULTIX_RABBITMQ_AUTH_EMAIL_CHANGED_ROUTING_KEY=auth.notification.email-changed
VAULTIX_RABBITMQ_AUTH_EMAIL_REVERTED_ROUTING_KEY=auth.notification.email-reverted

# Eureka Service Discovery
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://localhost:8761/eureka/
