# Authorization Service Environment Variables
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vaultix_auth_db
SPRING_DATASOURCE_USERNAME=auth_user
SPRING_DATASOURCE_PASSWORD=auth_password

# Initial Admin Bootstrapping
VAULTIX_ADMIN_ENABLED=true
VAULTIX_ADMIN_USERNAME=admin
VAULTIX_ADMIN_EMAIL=admin@vaultix.com
VAULTIX_ADMIN_PASSWORD=Admin@Vaultix2026!
VAULTIX_ADMIN_FULL_NAME=Vaultix Administrator

# Security & Master Key (KEK) for AES-256 Private Key Encryption at Rest
VAULTIX_SECURITY_KEK_MASTER_KEY=3xhw5B4DZicmirWLS4h3ZkA4pBFZwyKlG6cvEYvdf7I=

# Redis Configuration (Cache & Cross-Instance Pub/Sub)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_USERNAME=auth_user
SPRING_DATA_REDIS_PASSWORD=auth_password

# JWT Token Lifespans & Issuer
VAULTIX_JWT_ISSUER=https://auth.vaultix.com
VAULTIX_JWT_ACCESS_TOKEN_EXPIRATION=5m
VAULTIX_JWT_REFRESH_TOKEN_EXPIRATION=7d

# Automatic Signing Key Rotation Schedule (Daily at 02:00 AM)
VAULTIX_KEY_ROTATION_CRON=0 0 2 * * ?

# Automatic Signing Key Cleanup Schedule (Daily at 02:10 AM - 10 min after rotation)
VAULTIX_KEY_CLEANUP_CRON=0 10 2 * * ?
VAULTIX_KEY_CLEANUP_GRACE_PERIOD=7d
VAULTIX_KEY_CLEANUP_BATCH_SIZE=100

# Automatic Refresh Token (Session) Cleanup Schedule (Daily at 02:20 AM - 10 min after key cleanup)
VAULTIX_REFRESH_TOKEN_CLEANUP_CRON=0 20 2 * * ?
VAULTIX_REFRESH_TOKEN_CLEANUP_GRACE_PERIOD=7d
VAULTIX_REFRESH_TOKEN_CLEANUP_BATCH_SIZE=500
